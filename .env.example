# Copie este arquivo para .env.local e preencha com os valores do seu
# projeto Supabase. NUNCA versione o arquivo .env.local (já está no
# .gitignore) nem publique estes valores fora deste repositório.

# Painel do projeto Supabase > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Somente para uso em scripts de servidor/administração (ex.: migração da
# planilha). NUNCA prefixar com NEXT_PUBLIC_, NUNCA importar em código que
# roda no navegador, e NUNCA commitar o valor real.
SUPABASE_SERVICE_ROLE_KEY=
